# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://descobertasuteisbrasil.com.br

# Google Analytics 4 — Measurement ID (Admin → Fluxos de dados → Web). Ex.: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads — ID da tag (Ferramentas → Configuração → Google tag). Ex.: AW-XXXXXXXXXX
# Opcional. A conversão recomendada é importar o evento affiliate_click do GA4.
NEXT_PUBLIC_GOOGLE_ADS_ID=
